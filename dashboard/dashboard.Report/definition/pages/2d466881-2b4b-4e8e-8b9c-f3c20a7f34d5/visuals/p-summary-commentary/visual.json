                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Compare Net Sales with orders, units, and AOV: sales growth from more orders is different from growth caused by larger baskets or higher-priced mix.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Use discount rate and promotion views to identify where discounting supports volume, then check gross profit and margin separately.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Profitability is directional because discounts are treated as per-unit values and COGS comes from the current product catalog rather than confirmed historical cost.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
