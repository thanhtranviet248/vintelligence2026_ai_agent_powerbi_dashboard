              {
                "textRuns": [
                  {
                    "value": "Customer satisfaction readout",
                    "textStyle": {
                      "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
                      "fontSize": "13pt",
                      "color": "#17365D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Interpret average rating together with review count and positive/negative review rates; a small review sample should not determine a product ranking.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Use review-date trends to identify changes in customer feedback, then compare products with delivery, returns, and sales indicators for investigation.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "These comparisons identify associations for follow-up and do not prove that delivery, returns, or another factor caused a rating outcome.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
              }
