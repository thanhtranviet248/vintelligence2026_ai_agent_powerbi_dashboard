                "textRuns": [
                  {
                    "value": "Returns and product quality readout",
                    "textStyle": {
                      "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
                      "fontSize": "13pt",
                      "color": "#17365D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Use the dropdown filters above to select a reporting period, category, product, or region; multiple selections are supported. Read returned orders, return quantity, refund amount, and return rate together; high quantity does not always mean high financial impact.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Use return reasons and product/category views to distinguish possible quality signals from delivery, preference, or other recorded causes.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Return activity is shown by return date, while cohort comparisons use order context. Check the date basis before comparing trends or rates.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
