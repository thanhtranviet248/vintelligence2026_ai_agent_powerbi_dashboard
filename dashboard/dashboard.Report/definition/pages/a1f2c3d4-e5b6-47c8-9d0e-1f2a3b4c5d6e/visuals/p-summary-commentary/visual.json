              {
                "textRuns": [
                  {
                    "value": "Customer and market readout",
                    "textStyle": {
                      "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
                      "fontSize": "13pt",
                      "color": "#17365D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Read customer count, orders, revenue per customer, and AOV together to distinguish market reach from purchasing depth.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Acquisition channel explains how customers were obtained; order source and device explain where orders were placed. Do not combine these meanings.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Use region, age, gender, and customer detail views to find high-value or underperforming segments, then validate the pattern against the selected period.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
              }
            ]
