                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This page is a balanced view of demand coverage, inventory risk, returns, customer experience, and repeat purchasing—not a duplicate sales detail page.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Use the KPI cards to spot the strongest cross-domain signals, then use the category risk and product value-versus-experience map to choose where to investigate.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The map is diagnostic: high sales, rating, and unit volume identify important products, while low review samples or missing operational records require caution.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
