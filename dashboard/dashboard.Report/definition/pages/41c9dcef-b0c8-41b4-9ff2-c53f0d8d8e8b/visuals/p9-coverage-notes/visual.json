          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Interpretation and known data gaps",
                    "textStyle": {
                      "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
                      "fontSize": "14pt",
                      "color": "#17365D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Shipment rows cover 566,067 of 646,945 orders. Missing shipment records mean shipment data is unavailable, not that an order is open, late, or cancelled.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "11pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The three-day transit split is diagnostic only. No promised delivery date or approved service-level target is present, so the model cannot measure late or on-time delivery.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "11pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Inventory has 126 monthly product snapshots. Commerce starts 2012-07-04; web traffic starts 2013-01-01. Do not interpret snapshots as weekly/daily balances or sum stock across dates.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "11pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Net Sales are based on order items and exclude refunds. The separate sales.csv benchmark is not the same revenue fact. Blank promotion references are unknown, so promotion attribution is incomplete.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "11pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Sixteen repeated order_id + product_id combinations are documented in the source; retain the rows unless the source owner confirms a deduplication rule.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "11pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Product COGS comes from the current catalog, not confirmed historical unit cost; gross profit is an estimate. Net Sales also depends on the unconfirmed per-unit discount assumption.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "11pt",
                      "color": "#344054"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
