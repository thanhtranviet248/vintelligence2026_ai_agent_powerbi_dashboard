                "textRuns": [
                  {
                    "value": "Use the dropdown filters above to select a reporting period, category, product, or region; multiple selections are supported. Use this page to confirm source coverage, date roles, snapshot grain, status populations, and the denominator behind each headline metric.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Missing shipment, review, inventory, promotion, or date records should be treated as unavailable data rather than silently interpreted as negative business outcomes.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Metric caveats are part of the result: catalog COGS, per-unit discounts, incomplete promotion attribution, and the absence of a promised delivery date limit interpretation.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
