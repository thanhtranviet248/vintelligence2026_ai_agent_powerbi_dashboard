                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Use one comparison at a time: stock availability versus sales, transit group versus returns, promotion status versus sales, or ratings versus operational signals.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Check the displayed sample count and denominator before interpreting a rate or average, especially for product-level delivery and satisfaction comparisons.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "These are observational associations. They are intended to identify investigation priorities, not to estimate lost sales or claim causation.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
