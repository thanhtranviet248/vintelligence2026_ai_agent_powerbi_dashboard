                "textRuns": [
                  {
                    "value": "Cross-domain diagnostic readout",
                    "textStyle": {
                      "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
                      "fontSize": "13pt",
                      "color": "#17365D"
