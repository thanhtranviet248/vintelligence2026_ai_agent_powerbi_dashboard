{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "p-summary-commentary",
  "position": {
    "x": 40,
    "y": 110,
    "z": 1000,
    "height": 140,
    "width": 1840,
    "tabOrder": 10
  },
  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Inventory readout",
                    "textStyle": {
                      "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
                      "fontSize": "13pt",
                      "color": "#17365D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Select one monthly snapshot before interpreting stock on hand, inventory value, stockout, or overstock indicators; balances must not be summed across snapshots.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Prioritise products with low availability and strong observed sales movement, then use reorder and days-of-supply indicators to guide investigation.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The visuals show observed inventory conditions, not measured lost sales. A shortage is a risk signal unless unmet demand has been explicitly captured.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#344054"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
