table Orders
	lineageTag: 96ce3597-5dc5-418f-a932-8f8efcb791d2

	measure 'Total Orders' = DISTINCTCOUNT(Orders[OrderID])
		lineageTag: a35029f5-bc5c-43e8-ac8f-80defd964c81

	measure 'Distinct Customers' = DISTINCTCOUNT(Orders[CustomerID])
		lineageTag: 60ff5ca2-1d41-4d10-912a-14e5f8d49ccd

	measure 'Shipped Orders' = CALCULATE([Total Orders], OR(Orders[OrderStatus]="shipped", Orders[OrderStatus]="delivered"))
		lineageTag: b7e306f8-ecee-4672-9f6e-e99b6ada2d2e

	measure 'Delivered Orders' = CALCULATE([Total Orders], Orders[OrderStatus]="delivered")
		lineageTag: cff9a99d-2622-45c2-9585-266f4243d62a

	measure 'Pending Orders' = CALCULATE([Total Orders], OR(Orders[OrderStatus]="created", Orders[OrderStatus]="paid"))
		lineageTag: 19042fa2-6290-4268-b4a3-2cac324bc965

	measure 'Cancelled Orders' = CALCULATE([Total Orders], Orders[OrderStatus]="cancelled")
		lineageTag: f5259cd5-3630-425c-97c5-7c3c25212f03

	measure 'Returned Status Orders' = CALCULATE([Total Orders], Orders[OrderStatus]="returned")
		lineageTag: 47a09bcd-60f8-4ae2-9eb9-f7661308d088

	measure 'New Customers' = COUNTROWS(FILTER(VALUES(Orders[CustomerID]), VAR FirstOrderDate = CALCULATE(MIN(Orders[OrderDate]), ALL(Orders[OrderDate])) RETURN FirstOrderDate >= MIN(Date[Date]) && FirstOrderDate <= MAX(Date[Date])))
		lineageTag: a240c9d6-4c3b-4d42-b0f5-6bb86362a131

	measure 'Repeat Customers' = COUNTROWS(FILTER(VALUES(Orders[CustomerID]), VAR FirstOrderDate = CALCULATE(MIN(Orders[OrderDate]), ALL(Orders[OrderDate])) RETURN FirstOrderDate < MIN(Date[Date])))
		lineageTag: f7992051-8df5-4fcc-a62a-c7e66cc6debe

	measure 'Order Frequency' = DIVIDE([Total Orders], [Distinct Customers])
		lineageTag: 96573a9b-4256-42dd-92af-f003af1ecdf9

	measure 'All-Time First-Time Customers' = COUNTROWS(FILTER(CALCULATETABLE(VALUES(Orders[CustomerID]), ALL('Date')), CALCULATE(DISTINCTCOUNT(Orders[OrderID]), ALL('Date')) = 1))
		lineageTag: a4e75259-922a-4823-b92e-b7f5c95f0ac6

	measure 'All-Time Repeat Customers' = COUNTROWS(FILTER(CALCULATETABLE(VALUES(Orders[CustomerID]), ALL('Date')), CALCULATE(DISTINCTCOUNT(Orders[OrderID]), ALL('Date')) > 1))
		lineageTag: 2ca954ff-6ce3-4e7d-ad98-189d3957877a

	measure 'All-Time First-Time Customer Rate' = DIVIDE([All-Time First-Time Customers], CALCULATE([Distinct Customers], ALL('Date')))
		formatString: 0.0%
		lineageTag: 96155264-530a-45d5-859c-3ead2eb4552f

	measure 'All-Time Repeat Customer Rate' = DIVIDE([All-Time Repeat Customers], CALCULATE([Distinct Customers], ALL('Date')))
		formatString: 0.0%
		lineageTag: db505b65-9042-49bf-a8cb-6d50a569ec29

	measure 'Fulfillment Rate' = DIVIDE([Delivered Orders], [Total Orders])
		lineageTag: 4f0f781f-a96c-4c41-a445-698f2a6a8ea7

	measure 'Order Status Mix' = DIVIDE([Total Orders], CALCULATE([Total Orders], ALL(Orders[OrderStatus])))
		lineageTag: d5ed3f60-f414-43b9-969f-559b3c157375

