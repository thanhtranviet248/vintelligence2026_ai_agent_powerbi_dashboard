	/// Units in the order (sum of OrderItems quantity), banded. Blank for an order without lines. Sorted by Basket Size Order.
	column 'Basket Size' = SWITCH(Orders[Basket Size Order], 1, "1 unit", 2, "2 units", 3, "3 units", 4, "4–5 units", 5, "6–10 units", 6, "11+ units")
		dataType: string
		lineageTag: e6b7705d-ad47-4161-8705-32d02f876308
		summarizeBy: none
		sortByColumn: 'Basket Size Order'

		annotation SummarizationSetBy = Automatic

	/// Sort order for Basket Size.
	column 'Basket Size Order' = VAR Units = CALCULATE(SUM(OrderItems[Quantity]), ALLEXCEPT(Orders, Orders[OrderID])) RETURN SWITCH(TRUE(), ISBLANK(Units), BLANK(), Units = 1, 1, Units = 2, 2, Units = 3, 3, Units <= 5, 4, Units <= 10, 5, 6)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5acf8eb1-ab28-48cb-97be-c9707da87441
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

