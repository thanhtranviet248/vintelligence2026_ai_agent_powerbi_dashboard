	measure 'Total Orders' = DISTINCTCOUNT(Orders[OrderID])
	measure 'Distinct Customers' = DISTINCTCOUNT(Orders[CustomerID])
	measure 'Shipped Orders' = CALCULATE([Total Orders], OR(Orders[OrderStatus]="shipped", Orders[OrderStatus]="delivered"))
	measure 'Delivered Orders' = CALCULATE([Total Orders], Orders[OrderStatus]="delivered")
	measure 'Pending Orders' = CALCULATE([Total Orders], OR(Orders[OrderStatus]="created", Orders[OrderStatus]="paid"))
	measure 'Cancelled Orders' = CALCULATE([Total Orders], Orders[OrderStatus]="cancelled")
	measure 'Fulfillment Rate' = DIVIDE([Delivered Orders], [Total Orders])
	measure 'Order Status Mix' = DIVIDE([Total Orders], CALCULATE([Total Orders], ALL(Orders[OrderStatus])))

