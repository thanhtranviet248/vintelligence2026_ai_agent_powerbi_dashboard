		sourceColumn: discount_amount
		annotation SummarizationSetBy = Automatic

	column PromoID
		dataType: string
		lineageTag: 2e9ae75e-17e7-4d9d-bd02-0d4a1e87a54b
		summarizeBy: none
		sourceColumn: promo_id
		annotation SummarizationSetBy = Automatic
		annotation PBI_FormatHint = {"isText":true}

	column PromoID2
		dataType: string
		lineageTag: 8de55e0d-c1ef-4d5a-a0ec-8f79413031b3
		summarizeBy: none
		sourceColumn: promo_id_2
		annotation SummarizationSetBy = Automatic
		annotation PBI_FormatHint = {"isText":true}

	measure 'Gross Sales' = SUMX(OrderItems, OrderItems[Quantity] * OrderItems[UnitPrice])
	measure 'Net Sales' = SUMX(OrderItems, OrderItems[Quantity] * (OrderItems[UnitPrice] - OrderItems[DiscountAmount]))
	measure 'Units Sold' = SUM(OrderItems[Quantity])
	measure 'Average Order Value' = DIVIDE([Net Sales], [Total Orders])
	measure 'Revenue per Customer' = DIVIDE([Net Sales], [Distinct Customers])
	measure 'Contribution %' = DIVIDE([Net Sales], CALCULATE([Net Sales], ALL(Products[Category])))

	partition OrderItems-0a12d14d-5d7c-4cda-a23d-3f6b1ec909e5 = m
		mode: import
		source = ```
			let
			    Source = Csv.Document(File.Contents("D:\projects\VinTelligence2026\data\order_items.csv"), [Delimiter = ",", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
