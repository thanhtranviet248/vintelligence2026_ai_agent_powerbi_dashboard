	/// ABC class by annual usage at cost (units sold x COGS over the last 12 snapshot months in the data): A = products making up the first 80% of usage, B = the next 15%, C = the rest. Fixed at refresh; slicers do not change it.
	column 'ABC Class' = VAR LastSnapshot = MAX(Inventory[SnapshotDate]) VAR Recent = ADDCOLUMNS(FILTER(Inventory, Inventory[SnapshotDate] > EOMONTH(LastSnapshot, -12)), "@Cost", Inventory[UnitsSold] * RELATED(Products[COGS])) VAR ByProduct = GROUPBY(Recent, Inventory[ProductID], "@Usage", SUMX(CURRENTGROUP(), [@Cost])) VAR MyUsage = SUMX(FILTER(ByProduct, Inventory[ProductID] = Products[ProductID]), [@Usage]) VAR TotalUsage = SUMX(ByProduct, [@Usage]) VAR UsageBefore = SUMX(FILTER(ByProduct, [@Usage] > MyUsage), [@Usage]) VAR ShareBefore = DIVIDE(UsageBefore, TotalUsage) RETURN IF(ISBLANK(MyUsage) || MyUsage <= 0, "No recent sales", IF(ShareBefore < 0.8, "A", IF(ShareBefore < 0.95, "B", "C")))
		dataType: string
		lineageTag: 42b220da-c8d2-4b16-9dcd-83ce5e2520b2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

