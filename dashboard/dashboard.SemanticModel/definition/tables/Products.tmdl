table Products
	lineageTag: 8f546b66-4b3a-4075-a6db-a5bfc3cb130a

	/// Scorecard text: names the measures where a category is worse than all selected categories (negative net sales growth, stockout rate or return rate above the overall rate). Blank outside a category row.
	measure 'Category Watch Flag' =
			VAR Growth = [Net Sales YoY %]
			VAR Stockout = [Stockout Rate]
			VAR StockoutAll = CALCULATE([Stockout Rate], ALLSELECTED(Products[Category]))
			VAR ReturnRate = [Return Rate for Product Orders]
			VAR ReturnAll = CALCULATE([Return Rate for Product Orders], ALLSELECTED(Products[Category]))
			VAR Issues =
				CONCATENATEX(
					FILTER(
						{
							(1, "Sales falling", NOT ISBLANK(Growth) && Growth < 0),
							(2, "Stockouts high", NOT ISBLANK(Stockout) && Stockout > StockoutAll),
							(3, "Returns high", NOT ISBLANK(ReturnRate) && ReturnRate > ReturnAll)
						},
						[Value3]
					),
					[Value2], ", ", [Value1], ASC
				)
			RETURN
				IF(
					ISINSCOPE(Products[Category]),
					IF(Issues = "", "✓ No flags", "⚠ " & Issues)
				)
		lineageTag: 691ac6da-f09b-44a5-9b72-a6c8c45f6e66

	/// Heading text for the Category Tooltip: the hovered category, or "All categories" when none or several are in context.
	measure 'Selected Category' = SELECTEDVALUE(Products[Category], "All categories")
		lineageTag: 34c5451f-f1f6-496b-b5e4-a8608b7724f5

