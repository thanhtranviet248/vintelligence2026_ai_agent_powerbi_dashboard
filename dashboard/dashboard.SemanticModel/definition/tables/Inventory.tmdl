	column Segment
		dataType: string
		lineageTag: c0ad49c9-d80b-4d89-b3ca-39f2d5bc0b5e
		summarizeBy: none
		sourceColumn: segment
		annotation SummarizationSetBy = Automatic
		annotation PBI_FormatHint = {"isText":true}

	measure 'Current Stock' = SUM(Inventory[StockOnHand])
	measure 'Inventory Value' = SUMX(Inventory, Inventory[StockOnHand] * RELATED(Products[Price]))
	measure 'Stock In' = SUM(Inventory[UnitsReceived])
	measure 'Stock Out' = SUM(Inventory[UnitsSold])
	measure 'Low-Stock Products' = COUNTROWS(FILTER(Inventory, Inventory[StockOnHand] <= 20))
	measure 'Out-of-Stock Products' = COUNTROWS(FILTER(Inventory, Inventory[StockOnHand] = 0))
	measure 'Days of Inventory on Hand' = AVERAGE(Inventory[StockOnHand])

	partition Inventory-3b69bbc0-5357-4b15-9001-0d7f9adfd4da = m
		mode: import
		source = ```
			let
			    Source = Csv.Document(File.Contents("D:\projects\VinTelligence2026\data\inventory.csv"), [Delimiter = ",", Columns = 17, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
