	/// Days-of-supply band of the product in this snapshot row (source days_of_supply). Blank stays blank.
	column 'Cover Band' = IF(ISBLANK(Inventory[DaysOfSupply]), BLANK(), IF(Inventory[DaysOfSupply] < 30, "Under 30 days", IF(Inventory[DaysOfSupply] < 90, "30–90 days", IF(Inventory[DaysOfSupply] < 180, "90–180 days", IF(Inventory[DaysOfSupply] < 365, "180–365 days", "Over 365 days")))))
		dataType: string
		lineageTag: 6bdb6292-52a4-4dcd-8a64-fe4110a0b8ff
		summarizeBy: none
		sortByColumn: 'Cover Band Order'

		annotation SummarizationSetBy = Automatic

	/// Sort order for Cover Band.
	column 'Cover Band Order' = IF(ISBLANK(Inventory[DaysOfSupply]), BLANK(), IF(Inventory[DaysOfSupply] < 30, 1, IF(Inventory[DaysOfSupply] < 90, 2, IF(Inventory[DaysOfSupply] < 180, 3, IF(Inventory[DaysOfSupply] < 365, 4, 5)))))
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ff6da0e2-794b-4f5f-b93d-585e060e2255
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Planning risk per product and snapshot month, the same rule as Planning Action: Shortage risk at or below 20 units or under 30 days of cover (StockOnHand / UnitsSold x 30); Excess stock when overstock-flagged and above 90 days of cover (StockOnHand > 3 x UnitsSold); otherwise Healthy.
	column 'Stock Risk' = IF(Inventory[StockOnHand] <= 20 || (Inventory[UnitsSold] > 0 && DIVIDE(Inventory[StockOnHand], Inventory[UnitsSold]) * 30 < 30), "Shortage risk", IF(Inventory[OverstockFlag] = 1 && Inventory[StockOnHand] > 3 * Inventory[UnitsSold], "Excess stock", "Healthy"))
		dataType: string
		lineageTag: 76a588fa-011e-4d67-b117-292cef060d77
		summarizeBy: none
		sortByColumn: 'Stock Risk Order'

		annotation SummarizationSetBy = Automatic

	/// Sort order for Stock Risk.
	column 'Stock Risk Order' = IF(Inventory[StockOnHand] <= 20 || (Inventory[UnitsSold] > 0 && DIVIDE(Inventory[StockOnHand], Inventory[UnitsSold]) * 30 < 30), 1, IF(Inventory[OverstockFlag] = 1 && Inventory[StockOnHand] > 3 * Inventory[UnitsSold], 2, 3))
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: cba66d24-a528-4f59-aa11-29d50eaa1176
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Inventory-3b69bbc0-5357-4b15-9001-0d7f9adfd4da = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:\projects\vintelligence2026_ai_agent_powerbi_dashboard\data\inventory.csv"), [Delimiter = ",", Columns = 17, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"snapshot_date", type date}, {"product_id", Int64.Type}, {"stock_on_hand", Int64.Type}, {"units_received", Int64.Type}, {"units_sold", Int64.Type}, {"stockout_days", Int64.Type}, {"days_of_supply", type number}, {"fill_rate", type number}, {"stockout_flag", Int64.Type}, {"overstock_flag", Int64.Type}, {"reorder_flag", Int64.Type}, {"sell_through_rate", type number}, {"product_name", type text}, {"category", type text}, {"segment", type text}, {"year", Int64.Type}, {"month", Int64.Type}}),
				    #"Removed Unused Columns" = Table.RemoveColumns(#"Changed Type", {"sell_through_rate", "year", "month"})
				in
				    #"Removed Unused Columns"

