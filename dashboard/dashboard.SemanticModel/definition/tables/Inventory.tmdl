table Inventory
	lineageTag: 7f3069cc-2f58-4d80-8d7f-ef8dbd8a4ed0

	measure 'Current Stock' = VAR LatestSnapshot = MAX(Inventory[SnapshotDate]) RETURN CALCULATE(SUM(Inventory[StockOnHand]), Inventory[SnapshotDate] = LatestSnapshot)
		lineageTag: 858c1591-e9e0-4082-bde1-0fd217d73349

	measure 'Inventory Value' = VAR LatestSnapshot = MAX(Inventory[SnapshotDate]) RETURN CALCULATE(SUMX(Inventory, Inventory[StockOnHand] * RELATED(Products[Price])), Inventory[SnapshotDate] = LatestSnapshot)
		lineageTag: 166e8752-691b-4647-92bd-4d343177875a

	measure 'Stock In' = SUM(Inventory[UnitsReceived])
		lineageTag: 9a5aebf7-2a8b-4e31-8757-417b0e527c55

	measure 'Stock Out' = SUM(Inventory[UnitsSold])
		lineageTag: 6f9e2557-beb6-47c8-9c5f-af88f6d61118

	measure 'Low-Stock Products' = VAR LatestSnapshot = MAX(Inventory[SnapshotDate]) RETURN CALCULATE(DISTINCTCOUNT(Inventory[ProductID]), Inventory[SnapshotDate] = LatestSnapshot, Inventory[StockOnHand] <= 20)
		lineageTag: 283265a7-a696-4292-a5f0-2664d01ce213

	measure 'Out-of-Stock Products' = VAR LatestSnapshot = MAX(Inventory[SnapshotDate]) RETURN CALCULATE(DISTINCTCOUNT(Inventory[ProductID]), Inventory[SnapshotDate] = LatestSnapshot, Inventory[StockOnHand] = 0)
		lineageTag: 013acd95-afae-4c7b-a679-9e7abe54bd8b

	measure 'Stockout Days' = AVERAGE(Inventory[StockoutDays])
		lineageTag: ed62fda7-92ca-4842-9cc9-299288057a60

	measure 'Days of Supply' = AVERAGE(Inventory[DaysOfSupply])
		lineageTag: b1eac39c-d444-4ac3-b23e-3f150c672b33

	measure 'Fill Rate' = AVERAGE(Inventory[FillRate])
		formatString: 0.0%
		lineageTag: c2e6e8f0-59b1-4fab-ac86-5eefdf0ddfdc

	measure 'Sell-Through Rate' = AVERAGE(Inventory[SellThroughRate])
		lineageTag: 53362be0-94ea-4bc1-9127-e61f0b61d788

	measure 'Reorder Candidates' = VAR LatestSnapshot = MAX(Inventory[SnapshotDate]) RETURN CALCULATE(DISTINCTCOUNT(Inventory[ProductID]), Inventory[SnapshotDate] = LatestSnapshot, Inventory[ReorderFlag] = 1)
		lineageTag: 5a71c040-2fac-4f47-aefc-b089db4583e8

	measure 'Stockout Rate' = DIVIDE(SUM(Inventory[StockoutFlag]), COUNTROWS(Inventory))
		formatString: 0.0%
		lineageTag: e655a24b-f3e7-4e4a-91e9-c40a75d3c15c

	measure 'Overstock Rate' = DIVIDE(SUM(Inventory[OverstockFlag]), COUNTROWS(Inventory))
		formatString: 0.0%
		lineageTag: 67ad1ff0-51b3-41d7-965c-d242eb95feb0

	measure 'Average Stock on Hand' = AVERAGE(Inventory[StockOnHand])
		lineageTag: 124ea199-8c17-4d48-ba10-5e6b5c1673c0

	measure 'Snapshot Dates' = DISTINCTCOUNT(Inventory[SnapshotDate])
		lineageTag: 3bd1bc02-9642-4cd9-af94-30d89d6efbc1

