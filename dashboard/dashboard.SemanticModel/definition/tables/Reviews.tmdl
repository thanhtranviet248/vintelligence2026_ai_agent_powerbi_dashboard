	column Rating
		dataType: int64
		formatString: 0
		lineageTag: 90319876-7dca-45fb-9f16-1d396c2267e4
		summarizeBy: average
		sourceColumn: rating
		annotation SummarizationSetBy = Automatic

	column ReviewTitle
		dataType: string
		lineageTag: 59065e24-0d4a-4b4d-94a6-c06f0a4de3a4
		summarizeBy: none
		sourceColumn: review_title
		annotation SummarizationSetBy = Automatic
		annotation PBI_FormatHint = {"isText":true}

	measure 'Average Rating' = AVERAGE(Reviews[Rating])
	measure 'Review Count' = COUNTROWS(Reviews)
	measure 'Positive Review Rate' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Rating] >= 4), [Review Count])
	measure 'Negative Review Rate' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Rating] <= 2), [Review Count])

	partition Reviews-d1f34ff8-f0fd-4358-9d6b-c95f4537b0f8 = m
