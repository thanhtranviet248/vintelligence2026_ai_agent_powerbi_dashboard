table Reviews
	lineageTag: 7008ce5d-12f2-4f05-a3ec-b9fd1ae5e553

	measure 'Average Rating' = AVERAGE(Reviews[Rating])
		lineageTag: ae64bd97-f6b7-4816-a8ad-b2668b14bb47

	measure 'Review Count' = COUNTROWS(Reviews)
		lineageTag: 3cb6d9ca-fed6-4868-b305-22ea8730b6f3

	measure 'Reviewed Orders' = DISTINCTCOUNT(Reviews[OrderID])
		lineageTag: 92f2ce08-f6f0-4ece-a132-f0d3c25c4efd

	measure 'Review Order Coverage Rate' = DIVIDE([Reviewed Orders], [Total Orders])
		formatString: 0.0%
		lineageTag: ed886dd0-a4a6-4cb1-9c67-1328dfd37bc9

	measure 'Positive Review Rate' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Rating] >= 4), [Review Count])
		formatString: 0.0%
		lineageTag: 5ee11cba-0f0a-4114-8fd1-bfe6af1f2bcc

	measure 'Negative Review Rate' = DIVIDE(CALCULATE(COUNTROWS(Reviews), Reviews[Rating] <= 2), [Review Count])
		formatString: 0.0%
		lineageTag: 32569c6a-e120-40c6-b87f-189f04e8617e

	measure 'Review Count by Review Date' = CALCULATE([Review Count], USERELATIONSHIP('Date'[Date], Reviews[ReviewDate]), CROSSFILTER('Date'[Date], Orders[OrderDate], NONE))
		formatString: #,0
		lineageTag: 53ba8692-a87a-48d4-b13b-6669c9fb6f53

	measure 'Average Rating by Review Date' = CALCULATE([Average Rating], USERELATIONSHIP('Date'[Date], Reviews[ReviewDate]), CROSSFILTER('Date'[Date], Orders[OrderDate], NONE))
		formatString: 0.0
		lineageTag: b8d3df91-f41c-4a74-9cf1-bb446b9f3de5

	measure 'Low Rating Products' = COUNTROWS(FILTER(VALUES(Products[ProductID]), [Average Rating] < 3))
		lineageTag: b8f38c6f-a1a3-4e09-9ff2-45dbcda457a0

	column ReviewID
		dataType: string
		lineageTag: e8601ff1-e0f1-43a6-8b71-d19847752ebd
		summarizeBy: none
		sourceColumn: review_id

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isText":true}

	column OrderID
		dataType: int64
		formatString: 0
		lineageTag: da0ef8e3-f96d-4bc9-a6e6-2df8d7d5d8a3
		summarizeBy: none
		sourceColumn: order_id

		annotation SummarizationSetBy = Automatic

	column ProductID
		dataType: int64
		formatString: 0
		lineageTag: a09b80ed-aecd-4d11-8afc-4dbdd30cf575
		summarizeBy: none
		sourceColumn: product_id

		annotation SummarizationSetBy = Automatic

	column CustomerID
		dataType: int64
		formatString: 0
		lineageTag: 7c087267-67cc-4e3a-b613-86a0d5249ffa
		summarizeBy: none
		sourceColumn: customer_id

		annotation SummarizationSetBy = Automatic

	column ReviewDate
		dataType: dateTime
		formatString: Short Date
		lineageTag: cdc13792-5a0b-4c8d-853a-da3ee5a5cfba
		summarizeBy: none
		sourceColumn: review_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Rating
		dataType: int64
		formatString: 0
		lineageTag: 90319876-7dca-45fb-9f16-1d396c2267e4
		summarizeBy: average
		sourceColumn: rating

		annotation SummarizationSetBy = Automatic

	column ReviewTitle
		dataType: string
		lineageTag: 59065e24-0d4a-4b4d-94a6-c06f0a4de3a4
		summarizeBy: none
		sourceColumn: review_title

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isText":true}

