table Returns
	lineageTag: 0048b1d5-bb30-4190-9e42-ea1d9056f39d

	measure 'Returned Orders' = DISTINCTCOUNT(Returns[OrderID])
		lineageTag: 181a146a-8b3d-450b-b10b-2a5362378639

	measure 'Return Quantity' = SUM(Returns[ReturnQuantity])
		lineageTag: 890b7584-34c2-4a5d-ac6e-5c4fb9eee8ba

	measure 'Return Amount' = SUM(Returns[RefundAmount])
		lineageTag: f2658a13-7756-4081-8e29-6dd8037206a3

	measure 'Return Rate' = DIVIDE([Returned Orders], [Total Orders])
		formatString: 0.0%
		lineageTag: ee358c2d-0b1e-4f0f-b732-d66bb9bd0da9

	measure 'Return Rate for Product Orders' = DIVIDE([Returned Orders], DISTINCTCOUNT(OrderItems[OrderID]))
		formatString: 0.0%
		lineageTag: 3a692559-cddb-4854-b365-9d0eb1d948a6

	measure 'Return Reason Share' = DIVIDE([Return Quantity], CALCULATE([Return Quantity], REMOVEFILTERS(Returns[ReturnReason])))
		formatString: 0.0%
		lineageTag: 7fd99d0b-0161-4e8d-8b5a-675ac01352a9

	measure 'Refund Amount' = SUM(Returns[RefundAmount])
		lineageTag: 52a919f0-abb3-462c-8716-b4cd48dba7d5

	measure 'Return Quantity by Return Date' = CALCULATE([Return Quantity], USERELATIONSHIP('Date'[Date], Returns[ReturnDate]), CROSSFILTER('Date'[Date], Orders[OrderDate], NONE))
		formatString: #,0
		lineageTag: 70e98b4a-8f2b-4899-99d8-0829c40d6ad7

	measure 'Refund Amount by Return Date' = CALCULATE([Refund Amount], USERELATIONSHIP('Date'[Date], Returns[ReturnDate]), CROSSFILTER('Date'[Date], Orders[OrderDate], NONE))
		formatString: $#,0.00;($#,0.00);$#,0.00
		lineageTag: 1faa4ef2-8332-490f-aac8-255c265e34b0

	measure 'Net Sales After Returns' = [Net Sales] - [Refund Amount]
		lineageTag: 5f54d2a8-86f3-44ed-8715-cca94c4727bb

	measure 'Return Reasons' = DISTINCTCOUNT(Returns[ReturnReason])
		lineageTag: 244b46e5-02ce-4633-a905-d698eb13dce9

