	measure 'Returned Orders' = DISTINCTCOUNT(Returns[OrderID])
	measure 'Return Quantity' = SUM(Returns[ReturnQuantity])
	measure 'Return Amount' = SUM(Returns[RefundAmount])
	measure 'Return Rate' = DIVIDE([Returned Orders], [Total Orders])
	measure 'Refund Amount' = SUM(Returns[RefundAmount])

