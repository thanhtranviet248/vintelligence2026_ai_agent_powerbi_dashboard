table Returns
	lineageTag: 0048b1d5-bb30-4190-9e42-ea1d9056f39d

	measure 'Returned Orders' = DISTINCTCOUNT(Returns[OrderID])
		formatString: #,0
		lineageTag: 181a146a-8b3d-450b-b10b-2a5362378639

	measure 'Return Quantity' = SUM(Returns[ReturnQuantity])
		formatString: #,0
		lineageTag: 890b7584-34c2-4a5d-ac6e-5c4fb9eee8ba

	measure 'Return Rate for Product Orders' = DIVIDE([Returned Orders], DISTINCTCOUNT(OrderItems[OrderID]))
		formatString: 0.0%
		lineageTag: 3a692559-cddb-4854-b365-9d0eb1d948a6

	measure 'Return Reason Share' = DIVIDE([Return Quantity], CALCULATE([Return Quantity], REMOVEFILTERS(Returns[ReturnReason], Returns[Return Reason Label])))
		formatString: 0.0%
		lineageTag: 7fd99d0b-0161-4e8d-8b5a-675ac01352a9

	measure 'Refund Amount' = SUM(Returns[RefundAmount])
		formatString: $#,0.00;($#,0.00);$#,0.00
		lineageTag: 52a919f0-abb3-462c-8716-b4cd48dba7d5

	/// Hex colour for the scorecard: dark red when a category's return rate for product orders is above the rate for all selected categories. Paired with the Watch column text.
	measure 'Return Rate Color' =
			VAR ThisRate = [Return Rate for Product Orders]
			VAR AllRate = CALCULATE([Return Rate for Product Orders], ALLSELECTED(Products[Category]))
			RETURN
				IF(ISBLANK(ThisRate), BLANK(), IF(ThisRate > AllRate, "#B42318", "#344054"))
		isHidden
		lineageTag: 9a7febf5-0ede-4b83-9e73-62aa8b807457

	/// Return Rate limited to orders placed at least 31 days before the data end date (the longest order-to-return gap), so recent months are not under-counted.
	measure 'Return Rate (Closed Window)' =
			VAR CutOff = [Data End Date] - 31
			RETURN
				DIVIDE(
					CALCULATE([Returned Orders], KEEPFILTERS(Orders[OrderDate] <= CutOff)),
					CALCULATE([Total Orders], KEEPFILTERS(Orders[OrderDate] <= CutOff)))
		formatString: 0.0%
		lineageTag: 01507b5a-609f-4153-9c66-b53d8301cfbb

	/// Refund Rate limited to orders placed at least 31 days before the data end date, so recent months are not under-counted.
	measure 'Refund Rate (Closed Window)' =
			VAR CutOff = [Data End Date] - 31
			RETURN
				DIVIDE(
					CALCULATE([Refund Amount], KEEPFILTERS(Orders[OrderDate] <= CutOff)),
					CALCULATE([Net Sales], KEEPFILTERS(Orders[OrderDate] <= CutOff)))
		formatString: 0.0%
		lineageTag: 0355112c-e089-441b-965b-f2b9dd3dfd95

	/// Number of return lines (order x product rows in Returns).
	measure 'Return Lines' = COUNTROWS(Returns)
		formatString: #,0
		lineageTag: 4596036b-ab0d-48c6-87bf-0fc206e4c853

	/// Average days from order date to return date across return lines.
	measure 'Average Days to Return' = AVERAGE(Returns[Days to Return])
		formatString: 0.0
		lineageTag: e325b2c5-304d-4e49-86ae-1809947c064b

	/// Average refund paid per returned order.
	measure 'Refund per Returned Order' = DIVIDE([Refund Amount], [Returned Orders])
		formatString: $#,0;($#,0);$#,0
		lineageTag: d7396f00-edd9-4efc-a441-65da09980822

	column OrderID
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0fb6b51d-5c0d-4d54-b123-6ada36dac3ff
		summarizeBy: none
		sourceColumn: order_id

		annotation SummarizationSetBy = Automatic

	column ProductID
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: a0d15d7d-8752-4d92-9eb0-4556b41c8952
		summarizeBy: none
		sourceColumn: product_id

		annotation SummarizationSetBy = Automatic

	column ReturnDate
		dataType: dateTime
		isHidden
		formatString: Short Date
		lineageTag: 60f81262-23fd-41de-8bc9-0d5601a4ec80
		summarizeBy: none
		sourceColumn: return_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column ReturnReason
		dataType: string
		lineageTag: 663a4dd0-c0ee-4f29-9987-eefc50d0e3a6
		summarizeBy: none
		sourceColumn: return_reason

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isText":true}

	column ReturnQuantity
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 9ae66d44-b815-4e90-b741-f20f65d3d1cf
		summarizeBy: sum
		sourceColumn: return_quantity

		annotation SummarizationSetBy = Automatic

	column RefundAmount
		dataType: double
		isHidden
		formatString: $#,0.00;($#,0.00);$#,0.00
		lineageTag: d7fd78cc-4ad6-41a0-8ef2-f9869d95ae78
		summarizeBy: sum
		sourceColumn: refund_amount

		annotation SummarizationSetBy = Automatic

	/// Days from the order date to the return date.
	column 'Days to Return' = INT(Returns[ReturnDate] - RELATED(Orders[OrderDate]))
		dataType: int64
		formatString: 0
		lineageTag: e0357c1b-19ce-4767-aab7-f44c174adab4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Readable return reason (wrong_size -> Wrong size).
	column 'Return Reason Label' = SWITCH(Returns[ReturnReason], "wrong_size", "Wrong size", "defective", "Defective", "not_as_described", "Not as described", "changed_mind", "Changed mind", "late_delivery", "Late delivery", Returns[ReturnReason])
		dataType: string
		lineageTag: c8b6da7f-c0ca-4bcf-a66e-60a138cc82b6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Returns-4efc74dc-6ee0-4f9f-8f22-319ec5ef649c = m
