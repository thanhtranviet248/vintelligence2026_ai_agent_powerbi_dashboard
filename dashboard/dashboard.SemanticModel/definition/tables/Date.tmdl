	partition Date-b4b5d9c0-c498-41af-8c9a-1296fd53372c = calculated
		mode: import
		source =
				ADDCOLUMNS(
					CALENDAR(DATE(2012,1,1), DATE(2022,12,31)),
					"Year-Month", FORMAT([Date], "YYYY-MM"),
					"Year-Month Sort", YEAR([Date]) * 100 + MONTH([Date]),
					"Month Start", DATE(YEAR([Date]), MONTH([Date]), 1),
					"Year", YEAR([Date])
				)

