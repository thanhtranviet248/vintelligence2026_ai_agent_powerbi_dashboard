table Date
	lineageTag: 6e5f99d5-5ee3-4d2f-8bce-39d10e7dce7d
	dataCategory: Time

	/// First order date in the data, ignoring all filters. Helper for growth measures.
	measure 'Data Start Date' = CALCULATE(MIN(Orders[OrderDate]), REMOVEFILTERS())
		formatString: Short Date
		isHidden
		lineageTag: 8ed1d8ac-8120-4806-b895-fa95bc17e84e

	/// Last order date in the data, ignoring all filters. Helper for growth measures.
	measure 'Data End Date' = CALCULATE(MAX(Orders[OrderDate]), REMOVEFILTERS())
		formatString: Short Date
		isHidden
		lineageTag: 92d993fa-d0f9-4f59-b3c5-5c9a8aae95c2

	/// Net Sales on the same dates one year earlier (order date). With no date filter it covers the 12 months before the latest 12 months of data.
	measure 'Net Sales Prior Year' =
			VAR FirstOrderDate = [Data Start Date]
			VAR LastOrderDate = [Data End Date]
			VAR DateIsFiltered = ISFILTERED('Date')
			VAR DefaultStart = EDATE(LastOrderDate, -12) + 1
			VAR PeriodDates =
				FILTER(
					VALUES('Date'[Date]),
					'Date'[Date] <= LastOrderDate
						&& EDATE('Date'[Date], -12) >= FirstOrderDate
						&& (DateIsFiltered || 'Date'[Date] >= DefaultStart)
				)
			VAR PriorDates = SELECTCOLUMNS(PeriodDates, "PriorDate", EDATE('Date'[Date], -12))
			VAR CurrentValue = CALCULATE([Net Sales], REMOVEFILTERS('Date'), PeriodDates)
			VAR PriorValue = CALCULATE([Net Sales], REMOVEFILTERS('Date'), TREATAS(PriorDates, 'Date'[Date]))
			RETURN
				PriorValue
		formatString: $#,0;($#,0);$#,0
		lineageTag: 8e8e7947-cf19-421a-af62-4c7472a15d73

	/// Growth of Net Sales versus the same dates one year earlier (like-for-like days, order date). With no date filter it compares the latest 12 months of data with the 12 months before. Dates whose prior-year date falls before the first order are excluded, so the first year is blank.
	measure 'Net Sales YoY %' =
			VAR FirstOrderDate = [Data Start Date]
			VAR LastOrderDate = [Data End Date]
			VAR DateIsFiltered = ISFILTERED('Date')
			VAR DefaultStart = EDATE(LastOrderDate, -12) + 1
			VAR PeriodDates =
				FILTER(
					VALUES('Date'[Date]),
					'Date'[Date] <= LastOrderDate
						&& EDATE('Date'[Date], -12) >= FirstOrderDate
						&& (DateIsFiltered || 'Date'[Date] >= DefaultStart)
				)
			VAR PriorDates = SELECTCOLUMNS(PeriodDates, "PriorDate", EDATE('Date'[Date], -12))
			VAR CurrentValue = CALCULATE([Net Sales], REMOVEFILTERS('Date'), PeriodDates)
			VAR PriorValue = CALCULATE([Net Sales], REMOVEFILTERS('Date'), TREATAS(PriorDates, 'Date'[Date]))
			RETURN
				DIVIDE(CurrentValue - PriorValue, PriorValue)
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		lineageTag: a75ec843-ac2f-4693-9571-8c4ee295ab86

	/// Growth of Gross Sales versus the same dates one year earlier (like-for-like days, order date). With no date filter it compares the latest 12 months of data with the 12 months before. Dates whose prior-year date falls before the first order are excluded, so the first year is blank.
	measure 'Gross Sales YoY %' =
			VAR FirstOrderDate = [Data Start Date]
			VAR LastOrderDate = [Data End Date]
			VAR DateIsFiltered = ISFILTERED('Date')
			VAR DefaultStart = EDATE(LastOrderDate, -12) + 1
			VAR PeriodDates =
