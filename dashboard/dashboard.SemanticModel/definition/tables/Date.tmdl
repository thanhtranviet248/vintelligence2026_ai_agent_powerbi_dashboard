			VAR CurrentValue = CALCULATE([Gross Sales], REMOVEFILTERS('Date'), PeriodDates)
			VAR PriorValue = CALCULATE([Gross Sales], REMOVEFILTERS('Date'), TREATAS(PriorDates, 'Date'[Date]))
