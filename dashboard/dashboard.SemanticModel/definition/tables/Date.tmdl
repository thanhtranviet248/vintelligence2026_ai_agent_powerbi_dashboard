	/// Hex colour for the card subtitle: green when [Total Orders vs PY Label] starts with ▲ (up), red when it starts with ▼ (down), grey otherwise. The arrow carries the meaning; colour repeats it.
	measure 'Total Orders vs PY Color' =
			VAR Arrow = LEFT([Total Orders vs PY Label], 1)
			RETURN
				SWITCH(Arrow, "▲", "#067647", "▼", "#B42318", "#667085")
		isHidden
		lineageTag: fc18dd84-b093-4e3c-b6a0-3ca5fd87e558

