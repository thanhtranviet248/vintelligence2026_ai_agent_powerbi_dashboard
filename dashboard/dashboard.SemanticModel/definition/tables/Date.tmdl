table Date
	lineageTag: 6e5f99d5-5ee3-4d2f-8bce-39d10e7dce7d
	dataCategory: Time

	/// First order date in the data, ignoring all filters. Helper for growth measures.
	measure 'Data Start Date' = CALCULATE(MIN(Orders[OrderDate]), REMOVEFILTERS())
		formatString: Short Date
		isHidden
		lineageTag: 8ed1d8ac-8120-4806-b895-fa95bc17e84e

	/// Last order date in the data, ignoring all filters. Helper for growth measures.
	measure 'Data End Date' = CALCULATE(MAX(Orders[OrderDate]), REMOVEFILTERS())
		formatString: Short Date
		isHidden
		lineageTag: 92d993fa-d0f9-4f59-b3c5-5c9a8aae95c2

	/// Net Sales on the same dates one year earlier (order date). With no date filter it covers the 12 months before the latest 12 months of data.
	measure 'Net Sales Prior Year' =
			VAR FirstOrderDate = [Data Start Date]
			VAR LastOrderDate = [Data End Date]
			VAR DateIsFiltered = ISFILTERED('Date')
			VAR DefaultStart = EDATE(LastOrderDate, -12) + 1
			VAR PeriodDates =
				FILTER(
					VALUES('Date'[Date]),
					'Date'[Date] <= LastOrderDate
						&& EDATE('Date'[Date], -12) >= FirstOrderDate
						&& (DateIsFiltered || 'Date'[Date] >= DefaultStart)
				)
			VAR PriorDates = SELECTCOLUMNS(PeriodDates, "PriorDate", EDATE('Date'[Date], -12))
			VAR CurrentValue = CALCULATE([Net Sales], REMOVEFILTERS('Date'), PeriodDates)
			VAR PriorValue = CALCULATE([Net Sales], REMOVEFILTERS('Date'), TREATAS(PriorDates, 'Date'[Date]))
			RETURN
				PriorValue
		formatString: $#,0;($#,0);$#,0
		lineageTag: 8e8e7947-cf19-421a-af62-4c7472a15d73

	/// Growth of Net Sales versus the same dates one year earlier (like-for-like days, order date). With no date filter it compares the latest 12 months of data with the 12 months before. Dates whose prior-year date falls before the first order are excluded, so the first year is blank.
	measure 'Net Sales YoY %' =
			VAR FirstOrderDate = [Data Start Date]
			VAR LastOrderDate = [Data End Date]
			VAR DateIsFiltered = ISFILTERED('Date')
			VAR DefaultStart = EDATE(LastOrderDate, -12) + 1
			VAR PeriodDates =
				FILTER(
					VALUES('Date'[Date]),
					'Date'[Date] <= LastOrderDate
						&& EDATE('Date'[Date], -12) >= FirstOrderDate
						&& (DateIsFiltered || 'Date'[Date] >= DefaultStart)
				)
			VAR PriorDates = SELECTCOLUMNS(PeriodDates, "PriorDate", EDATE('Date'[Date], -12))
			VAR CurrentValue = CALCULATE([Net Sales], REMOVEFILTERS('Date'), PeriodDates)
			VAR PriorValue = CALCULATE([Net Sales], REMOVEFILTERS('Date'), TREATAS(PriorDates, 'Date'[Date]))
			RETURN
				DIVIDE(CurrentValue - PriorValue, PriorValue)
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		lineageTag: a75ec843-ac2f-4693-9571-8c4ee295ab86

	/// Growth of Gross Profit versus the same dates one year earlier (like-for-like days, order date). With no date filter it compares the latest 12 months of data with the 12 months before. Dates whose prior-year date falls before the first order are excluded, so the first year is blank.
	measure 'Gross Profit YoY %' =
			VAR FirstOrderDate = [Data Start Date]
			VAR LastOrderDate = [Data End Date]
			VAR DateIsFiltered = ISFILTERED('Date')
			VAR DefaultStart = EDATE(LastOrderDate, -12) + 1
			VAR PeriodDates =
				FILTER(
					VALUES('Date'[Date]),
					'Date'[Date] <= LastOrderDate
						&& EDATE('Date'[Date], -12) >= FirstOrderDate
						&& (DateIsFiltered || 'Date'[Date] >= DefaultStart)
				)
			VAR PriorDates = SELECTCOLUMNS(PeriodDates, "PriorDate", EDATE('Date'[Date], -12))
			VAR CurrentValue = CALCULATE([Gross Profit], REMOVEFILTERS('Date'), PeriodDates)
			VAR PriorValue = CALCULATE([Gross Profit], REMOVEFILTERS('Date'), TREATAS(PriorDates, 'Date'[Date]))
			RETURN
				DIVIDE(CurrentValue - PriorValue, PriorValue)
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		lineageTag: c89b5516-5a45-4d82-aef5-9a465b3425ba

	/// Growth of Total Orders versus the same dates one year earlier (like-for-like days, order date). With no date filter it compares the latest 12 months of data with the 12 months before. Dates whose prior-year date falls before the first order are excluded, so the first year is blank.
	measure 'Total Orders YoY %' =
			VAR FirstOrderDate = [Data Start Date]
			VAR LastOrderDate = [Data End Date]
			VAR DateIsFiltered = ISFILTERED('Date')
			VAR DefaultStart = EDATE(LastOrderDate, -12) + 1
			VAR PeriodDates =
				FILTER(
					VALUES('Date'[Date]),
					'Date'[Date] <= LastOrderDate
						&& EDATE('Date'[Date], -12) >= FirstOrderDate
						&& (DateIsFiltered || 'Date'[Date] >= DefaultStart)
				)
			VAR PriorDates = SELECTCOLUMNS(PeriodDates, "PriorDate", EDATE('Date'[Date], -12))
			VAR CurrentValue = CALCULATE([Total Orders], REMOVEFILTERS('Date'), PeriodDates)
			VAR PriorValue = CALCULATE([Total Orders], REMOVEFILTERS('Date'), TREATAS(PriorDates, 'Date'[Date]))
			RETURN
				DIVIDE(CurrentValue - PriorValue, PriorValue)
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		lineageTag: 13684dcd-4927-48cc-a768-5089b299e734

	/// Net Sales of the latest month in context versus the month before it (order date). With no date filter that is the last month of data.
	measure 'Net Sales MoM %' =
			VAR FirstOrderDate = [Data Start Date]
			VAR LastOrderDate = [Data End Date]
			VAR AnchorDate = MIN(MAX('Date'[Date]), LastOrderDate)
			VAR MonthStart = DATE(YEAR(AnchorDate), MONTH(AnchorDate), 1)
			VAR MonthEnd = EOMONTH(AnchorDate, 0)
			VAR PrevStart = EDATE(MonthStart, -1)
			VAR PrevEnd = EOMONTH(AnchorDate, -1)
			VAR CurrentValue = CALCULATE([Net Sales], REMOVEFILTERS('Date'), DATESBETWEEN('Date'[Date], MonthStart, MonthEnd))
			VAR PriorValue = CALCULATE([Net Sales], REMOVEFILTERS('Date'), DATESBETWEEN('Date'[Date], PrevStart, PrevEnd))
			RETURN
				IF(PrevStart >= DATE(YEAR(FirstOrderDate), MONTH(FirstOrderDate), 1), DIVIDE(CurrentValue - PriorValue, PriorValue))
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		lineageTag: 3fa38e02-919e-4085-b052-d671834a94f0

	/// Card subtitle text: change in Total Orders versus the same dates a year earlier, with a ▲/▼ arrow and words so colour is not needed. With no date filter it compares the latest 12 months with the 12 months before (order date).
	measure 'Total Orders vs PY Label' =
			VAR FirstOrderDate = [Data Start Date]
			VAR LastOrderDate = [Data End Date]
			VAR DateIsFiltered = ISFILTERED('Date')
			VAR DefaultStart = EDATE(LastOrderDate, -12) + 1
			VAR PeriodDates =
				FILTER(
					VALUES('Date'[Date]),
					'Date'[Date] <= LastOrderDate
						&& EDATE('Date'[Date], -12) >= FirstOrderDate
						&& (DateIsFiltered || 'Date'[Date] >= DefaultStart)
				)
			VAR PriorDates = SELECTCOLUMNS(PeriodDates, "PriorDate", EDATE('Date'[Date], -12))
			VAR CurrentValue = CALCULATE([Total Orders], REMOVEFILTERS('Date'), PeriodDates)
			VAR PriorValue = CALCULATE([Total Orders], REMOVEFILTERS('Date'), TREATAS(PriorDates, 'Date'[Date]))
			VAR Change = DIVIDE(CurrentValue - PriorValue, PriorValue)
			VAR Scope = IF(DateIsFiltered, "vs same dates a year earlier", "last 12 months vs prior year")
			RETURN
				IF(
					ISBLANK(CurrentValue) || ISBLANK(PriorValue) || ISBLANK(Change),
					"No prior-year comparison (order date)",
					IF(Change > 0, "▲ ", IF(Change < 0, "▼ ", "■ ")) & FORMAT(ABS(Change), "0.0%") & " " & Scope & " (order date)"
				)
		lineageTag: 0bfb7ed4-00e1-4284-99ec-23eed08be135

	/// Header text: the last order date in the data, ignoring all filters.
	measure 'Data Through Label' = "Data through " & FORMAT([Data End Date], "d mmm yyyy")
		lineageTag: 8b514950-21ed-44db-b7b4-16014690944b

	/// Hex colour for Net Sales YoY % (card value, bars, table cells): green when growth is up (▲), red when down (▼), grey when flat. Always paired with the ▲/▼ format string.
	measure 'Net Sales YoY Color' =
			VAR Growth = [Net Sales YoY %]
			RETURN
				IF(ISBLANK(Growth), BLANK(), IF(Growth > 0, "#067647", IF(Growth < 0, "#B42318", "#667085")))
		isHidden
		lineageTag: 3936e61b-35f9-412e-8a1b-1c7d6420a5c6

	/// Hex colour for the Net Sales MoM % card value: green when up (▲), red when down (▼), grey when flat. Paired with the ▲/▼ format string.
	measure 'Net Sales MoM Color' =
			VAR Growth = [Net Sales MoM %]
			RETURN
				IF(ISBLANK(Growth), BLANK(), IF(Growth > 0, "#067647", IF(Growth < 0, "#B42318", "#667085")))
		isHidden
		lineageTag: 11b3160b-316f-42a7-8a92-c26f82520fb4

	/// Hex colour for the Gross Profit YoY % card value: green when up (▲), red when down (▼), grey when flat. Paired with the ▲/▼ format string.
	measure 'Gross Profit YoY Color' =
			VAR Growth = [Gross Profit YoY %]
			RETURN
				IF(ISBLANK(Growth), BLANK(), IF(Growth > 0, "#067647", IF(Growth < 0, "#B42318", "#667085")))
		isHidden
		lineageTag: 1f630f01-1601-4102-89f6-dd3646e7c64f

	/// Hex colour for the Total Orders YoY % card value: green when up (▲), red when down (▼), grey when flat. Paired with the ▲/▼ format string.
	measure 'Total Orders YoY Color' =
			VAR Growth = [Total Orders YoY %]
			RETURN
				IF(ISBLANK(Growth), BLANK(), IF(Growth > 0, "#067647", IF(Growth < 0, "#B42318", "#667085")))
		isHidden
		lineageTag: b2ffa1b8-7241-4ecb-93b8-8f5f218db01f

	/// Change in Inventory Value vs the same snapshot dates a year earlier, in percent (last 12 months when no date is filtered). Neutral colour: more stock is neither good nor bad on its own.
	measure 'Inventory Value vs PY Label' =
			VAR FirstOrderDate = [Data Start Date]
			VAR LastOrderDate = [Data End Date]
			VAR DateIsFiltered = ISFILTERED('Date')
			VAR DefaultStart = EDATE(LastOrderDate, -12) + 1
			VAR PeriodDates =
				FILTER(
					VALUES('Date'[Date]),
					'Date'[Date] <= LastOrderDate
						&& EDATE('Date'[Date], -12) >= FirstOrderDate
						&& (DateIsFiltered || 'Date'[Date] >= DefaultStart)
				)
			VAR PriorDates = SELECTCOLUMNS(PeriodDates, "PriorDate", EDATE('Date'[Date], -12))
			VAR CurrentValue = CALCULATE([Inventory Value], REMOVEFILTERS('Date'), PeriodDates)
			VAR PriorValue = CALCULATE([Inventory Value], REMOVEFILTERS('Date'), TREATAS(PriorDates, 'Date'[Date]))
			VAR Change = DIVIDE(CurrentValue - PriorValue, PriorValue)
			VAR Scope = IF(DateIsFiltered, "vs same dates a year earlier", "last 12 months vs prior year")
			RETURN
				IF(
					ISBLANK(CurrentValue) || ISBLANK(PriorValue) || ISBLANK(Change),
					"No prior-year comparison (snapshot date)",
					IF(Change > 0, "▲ ", IF(Change < 0, "▼ ", "■ ")) & FORMAT(ABS(Change), "0.0%") & " " & Scope & " (snapshot date)"
				)
		lineageTag: d47ec655-ba8d-43f4-84f6-6757dcdb7510

