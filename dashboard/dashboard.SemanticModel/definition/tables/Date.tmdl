	measure 'Revenue Growth' =
		VAR CurrentRevenue = [Net Sales]
		VAR PreviousRevenue = CALCULATE([Net Sales], DATEADD(Date[Date], -1, YEAR))
		RETURN
			DIVIDE(CurrentRevenue - PreviousRevenue, PreviousRevenue)

	measure 'Order Growth' =
		VAR CurrentOrderCount = [Total Orders]
		VAR PreviousOrderCount = CALCULATE([Total Orders], DATEADD(Date[Date], -1, YEAR))
		RETURN
			DIVIDE(CurrentOrderCount - PreviousOrderCount, PreviousOrderCount)

	measure 'Month-over-Month Growth' =
		VAR CurrentRevenue = [Net Sales]
		VAR PreviousRevenue = CALCULATE([Net Sales], DATEADD(Date[Date], -1, MONTH))
		RETURN
			DIVIDE(CurrentRevenue - PreviousRevenue, PreviousRevenue)

	measure 'Year-over-Year Growth' =
		VAR CurrentRevenue = [Net Sales]
		VAR PreviousRevenue = CALCULATE([Net Sales], DATEADD(Date[Date], -1, YEAR))
		RETURN
			DIVIDE(CurrentRevenue - PreviousRevenue, PreviousRevenue)

	partition Date-b4b5d9c0-c498-41af-8c9a-1296fd53372c = calculated
		mode: import
		source = ```
			ADDCOLUMNS(
				CALENDAR(DATE(2012,1,1), DATE(2023,12,31)),
				"Year", YEAR([Date]),
				"Month Number", MONTH([Date]),
				"Month Name", FORMAT([Date], "MMMM"),
				"Quarter", "Q" & FORMAT([Date], "Q"),
				"Year-Month", FORMAT([Date], "YYYY-MM"),
				"Year-Month Sort", YEAR([Date]) * 100 + MONTH([Date])
			)
			```
