					IF(Change > 0, "▲ ", IF(Change < 0, "▼ ", "■ ")) & FORMAT(ABS(Change) * 100, "0.0") & " pp" & " " & Scope & " (order date)"
				)
		lineageTag: 93ba4505-3711-4dc5-b0e5-3ec8739dc905

	/// Card subtitle text: change in Return Rate (Closed Window) versus the same dates a year earlier, with a ▲/▼ arrow and words so colour is not needed. Orders placed in the last 31 days before [Data End Date] are left out because their returns have not arrived yet. With no date filter it compares the latest 12 months with the 12 months before (order date).
	measure 'Return Rate vs PY Label' =
			VAR FirstOrderDate = [Data Start Date]
			VAR LastOrderDate = [Data End Date]
			VAR DateIsFiltered = ISFILTERED('Date')
			VAR DefaultStart = EDATE(LastOrderDate, -12) + 1
			VAR PeriodDates =
				FILTER(
					VALUES('Date'[Date]),
					'Date'[Date] <= LastOrderDate
						&& EDATE('Date'[Date], -12) >= FirstOrderDate
						&& (DateIsFiltered || 'Date'[Date] >= DefaultStart)
				)
			VAR PriorDates = SELECTCOLUMNS(PeriodDates, "PriorDate", EDATE('Date'[Date], -12))
			VAR CurrentValue = CALCULATE([Return Rate (Closed Window)], REMOVEFILTERS('Date'), PeriodDates)
			VAR PriorValue = CALCULATE([Return Rate (Closed Window)], REMOVEFILTERS('Date'), TREATAS(PriorDates, 'Date'[Date]))
			VAR Change = CurrentValue - PriorValue
			VAR Scope = IF(DateIsFiltered, "vs same dates a year earlier", "last 12 months vs prior year")
			RETURN
				IF(
					ISBLANK(CurrentValue) || ISBLANK(PriorValue) || ISBLANK(Change),
					"No prior-year comparison (order date)",
					IF(Change > 0, "▲ ", IF(Change < 0, "▼ ", "■ ")) & FORMAT(ABS(Change) * 100, "0.0") & " pp" & " " & Scope & " (order date)"
				)
		lineageTag: f570ed08-8709-4f9f-8b4c-888153e6ee2e

